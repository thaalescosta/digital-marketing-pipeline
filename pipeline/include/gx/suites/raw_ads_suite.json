{
  "name": "raw_ads",
  "meta": {
    "description": "Raw Google Ads daily contract, scoped to the run's date partition (PRD 9.3).",
    "table": "raw_ads_campaign_daily",
    "partition_column": "spend_date",
    "severity_policy": "CRITICAL fails the task; WARN logs and continues (PRD 9.5). Unknown severity defaults to CRITICAL.",
    "templating": "Strings containing {placeholders} are rendered by runner.py from the run context (ds, ds_plus_1, ds_plus_2, project, dataset, raw_dataset, marts_dataset, clause_*).",
    "notes": "Cross-column rules (clicks <= impressions, conversions <= clicks, avg_order_value > 0) are enforced as a zero-row query batch; avg_order_value is strictly positive so it is not expressed as an inclusive between."
  },
  "batches": [
    {
      "name": "ads",
      "type": "table",
      "table": "raw_ads_campaign_daily",
      "partition_column": "spend_date",
      "expectations": [
        {
          "type": "ExpectTableRowCountToBeBetween",
          "kwargs": {"min_value": 1},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToNotBeNull",
          "kwargs": {"column": "campaign_id"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToNotBeNull",
          "kwargs": {"column": "channel_id"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToNotBeNull",
          "kwargs": {"column": "ad_group_id"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToNotBeNull",
          "kwargs": {"column": "ad_id"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToNotBeNull",
          "kwargs": {"column": "spend_date"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectCompoundColumnsToBeUnique",
          "kwargs": {"column_list": ["campaign_id", "ad_group_id", "ad_id", "spend_date"]},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToEqual",
          "kwargs": {"column": "spend_date", "value": "{ds}"},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToBeBetween",
          "kwargs": {"column": "spend_usd", "min_value": 0},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToBeBetween",
          "kwargs": {"column": "impressions", "min_value": 0},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToBeBetween",
          "kwargs": {"column": "clicks", "min_value": 0},
          "meta": {"severity": "CRITICAL"}
        },
        {
          "type": "ExpectColumnValuesToBeBetween",
          "kwargs": {"column": "conversions", "min_value": 0},
          "meta": {"severity": "CRITICAL"}
        }
      ]
    },
    {
      "name": "ads_constraints",
      "type": "query",
      "sql": "SELECT 1 AS check_name FROM UNNEST([1]) AS x WHERE EXISTS (SELECT 1 FROM `{project}.{dataset}.raw_ads_campaign_daily` WHERE {clause_spend_date} AND (clicks > impressions OR conversions > clicks OR avg_order_value <= 0))",
      "expectations": [
        {
          "type": "ExpectTableRowCountToEqual",
          "kwargs": {"value": 0},
          "meta": {"severity": "CRITICAL"}
        }
      ]
    }
  ]
}