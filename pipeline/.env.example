# Digital-marketing pipeline environment.
# Copy to `.env` locally and fill in real values — this file contains NO secrets.
# GCP auth comes from the mounted service account (include/gcp_creds/) via
# GOOGLE_APPLICATION_CREDENTIALS; the key file itself is never committed.

GCP_PROJECT_ID=digital-marketing-509604
GCP_LOCATION=US
GCS_BUCKET=thaalescosta_marketing
BQ_DATASET=digital_marketing
SIM_START_DATE=2026-01-01
HISTORY_MONTHS=6
GEN_SEED=42
DAILY_SESSION_VOLUME=550
GOOGLE_APPLICATION_CREDENTIALS=/usr/local/airflow/include/gcp_creds/service_account.json

# Astro-standard core settings. The daily DAG sets is_paused_upon_creation=True itself,
# which overrides DAGS_ARE_PAUSED_AT_CREATION for that DAG.
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False